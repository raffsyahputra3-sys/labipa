{
  "name": "labipa-multiplayer",
  "version": "1.0.0",
  "description": "LabIPA 3D Studio · Socket.IO multiplayer + voice chat",
  "main": "server.js",
  "engines": {
    "node": "18.x"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "lint": "eslint server.js server/ scripts/ tests/ public/js/",
    "lint:fix": "eslint server.js server/ scripts/ tests/ public/js/ --fix",
    "rotate-key": "node scripts/gate-cli.js rotate",
    "reset-key": "node scripts/gate-cli.js reset",
    "verify-key": "node scripts/gate-cli.js verify"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.23.1",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "socket.io-client": "^4.8.4"
  }
}
